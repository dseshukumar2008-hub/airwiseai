# Optional: public browser key for Google Maps JavaScript API.
# Restrict this key to the required Maps JavaScript API and approved site origins.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional: server-only key for Google Air Quality API current conditions.
# Restrict this key to the Air Quality API; never use a NEXT_PUBLIC_ prefix.
GOOGLE_MAPS_API_KEY=

# Primary AI Provider: Google Gemini API (server-side only)
GEMINI_API_KEY=

# Fallback AI Provider: Groq API (server-side only)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
